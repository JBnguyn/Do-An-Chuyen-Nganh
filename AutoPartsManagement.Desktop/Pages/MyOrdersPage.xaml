<UserControl x:Class="AutoPartsManagement.Desktop.Pages.MyOrdersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Page_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- ===== Danh sách đơn ===== -->
        <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="20,14" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock x:Name="ListTitle" Text="Đơn hàng" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Padding="12,6" Click="Refresh_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" Margin="0,0,6,0" />
                                <TextBlock Text="Làm mới" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid>
                    <DataGrid x:Name="OrdersGrid" SelectionChanged="OrdersGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MÃ ĐƠN" Binding="{Binding Id, StringFormat='#{0}'}" Width="90" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="NGÀY ĐẶT" Binding="{Binding OrderDate, StringFormat='dd/MM/yyyy HH:mm'}" Width="140" />
                            <DataGridTextColumn Header="SỐ SP" Binding="{Binding OrderDetails.Count}" Width="70" />
                            <DataGridTextColumn Header="TỔNG TIỀN" Binding="{Binding TotalAmount, Converter={StaticResource Money}}" Width="*" />
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status, Converter={StaticResource OrderStatus}}" FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource OrderStatus}, ConverterParameter=color}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="&#xE8FD;" Style="{StaticResource IconText}" FontSize="44" Foreground="{StaticResource Line}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Bạn chưa có đơn hàng nào" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"
                                   HorizontalAlignment="Center" />
                        <Button Content="Mua sắm ngay" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                                HorizontalAlignment="Center" Click="Shop_Click" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ===== Chi tiết đơn ===== -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="18,0,0,0" Padding="22,18">
            <Grid>
                <TextBlock x:Name="NoSelection" Text="Chọn một đơn hàng để xem chi tiết." Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <DockPanel x:Name="DetailPanel" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top">
                        <Grid>
                            <TextBlock x:Name="DetailTitle" Style="{StaticResource SectionTitle}" />
                            <Border x:Name="StatusPill" HorizontalAlignment="Right" CornerRadius="10" Padding="10,3">
                                <TextBlock x:Name="StatusText" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBlock x:Name="DetailDate" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" />

                        <Border Margin="0,14,0,0" Padding="12" CornerRadius="8" Background="{StaticResource Bg}">
                            <StackPanel>
                                <TextBlock Text="NGƯỜI NHẬN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                                <TextBlock x:Name="ReceiverText" Margin="0,4,0,0" FontWeight="SemiBold" />
                                <TextBlock x:Name="AddressText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="13" />
                                <TextBlock x:Name="NotesText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="13"
                                           FontStyle="Italic" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="SẢN PHẨM" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,16,0,6" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="Tổng cộng" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="DetailTotal" HorizontalAlignment="Right" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource Red}" />
                        </Grid>
                        <Button x:Name="CancelButton" Margin="0,14,0,0" Style="{StaticResource GhostButton}"
                                Foreground="{StaticResource RedDark}" Click="CancelOrder_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" Style="{StaticResource IconText}" Margin="0,0,8,0" />
                                <TextBlock Text="Hủy đơn hàng" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="CancelHint" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource Muted}"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LinesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,8" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Product.Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                <TextBlock FontSize="12" Foreground="{StaticResource Muted}">
                                                    <Run Text="{Binding Quantity, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding UnitPrice, Mode=OneWay, Converter={StaticResource Money}}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SubTotal, Converter={StaticResource Money}}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
