<UserControl x:Class="AutoPartsManagement.Desktop.Pages.PlaceholderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Padding="40">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="&#xE822;" Style="{StaticResource IconText}" FontSize="46" Foreground="{StaticResource Line}"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,4" HorizontalAlignment="Center" />
            <TextBlock x:Name="HintText" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
