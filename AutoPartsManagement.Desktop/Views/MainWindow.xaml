<Window x:Class="AutoPartsManagement.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3H AUTO" Width="1280" Height="800" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
        Background="{StaticResource Bg}" Foreground="{StaticResource Ink}"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- ===== Menu bên trái ===== -->
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,20,20,8">
                    <Border Width="38" Height="38" CornerRadius="9" Background="{StaticResource Red}">
                        <TextBlock Text="&#xE804;" Style="{StaticResource IconText}" FontSize="20"
                                   Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="21">
                        <Run Text="3H" FontWeight="ExtraBold" Foreground="{StaticResource Red}" /><Run Text=" AUTO" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>

                <!-- Người dùng + đăng xuất -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource RedSoft}">
                            <TextBlock x:Name="AvatarText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="Bold" FontSize="16" Foreground="{StaticResource Red}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UserNameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="RoleText" FontSize="12" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="&#xE7E8;" Style="{StaticResource IconButton}" FontSize="15"
                                ToolTip="Đăng xuất" Click="Logout_Click" />
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,4,12,12">
                        <TextBlock Text="MUA HÀNG" Style="{StaticResource NavHeader}" />
                        <RadioButton x:Name="NavShop" Style="{StaticResource NavButton}" Tag="&#xE719;" Content="Cửa hàng" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavCart" Style="{StaticResource NavButton}" Tag="&#xE7BF;" Content="Giỏ hàng" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavMyOrders" Style="{StaticResource NavButton}" Tag="&#xE8FD;" Content="Đơn hàng của tôi" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavMaintenance" Style="{StaticResource NavButton}" Tag="&#xE804;" Content="Nhắc bảo dưỡng" Checked="Nav_Checked" />

                        <StackPanel x:Name="AdminNav" Visibility="Collapsed">
                            <TextBlock Text="QUẢN TRỊ" Style="{StaticResource NavHeader}" />
                            <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" Tag="&#xE9D2;" Content="Tổng quan" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavOrders" Style="{StaticResource NavButton}" Tag="&#xE7B8;" Content="Quản lý đơn hàng" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavProducts" Style="{StaticResource NavButton}" Tag="&#xE8EC;" Content="Sản phẩm &amp; tồn kho" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavImports" Style="{StaticResource NavButton}" Tag="&#xE896;" Content="Nhập kho" Checked="Nav_Checked" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Nội dung ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <!-- Thanh tiêu đề -->
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="28,16">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" FontSize="21" FontWeight="Bold" />
                        <TextBlock x:Name="PageSubtitle" FontSize="13" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Click="CartButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BF;" Style="{StaticResource IconText}" FontSize="16" />
                            <TextBlock Text="Giỏ hàng" Margin="8,0" VerticalAlignment="Center" />
                            <Border x:Name="CartBadge" Background="{StaticResource Red}" CornerRadius="10" MinWidth="22" Padding="6,1">
                                <TextBlock x:Name="CartCount" Text="0" Foreground="White" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <ContentControl x:Name="PageHost" Grid.Row="1" Margin="28,22,28,24" Focusable="False" />

            <!-- Thông báo nhỏ góc phải dưới -->
            <Border x:Name="Toast" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,28,28" Padding="16,12" CornerRadius="8" Background="{StaticResource Ink}"
                    Visibility="Collapsed" MaxWidth="420">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastIcon" Style="{StaticResource IconText}" Foreground="#4ADE80" FontSize="16" Margin="0,0,10,0" />
                    <TextBlock x:Name="ToastText" Foreground="White" TextWrapping="Wrap" MaxWidth="360" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
