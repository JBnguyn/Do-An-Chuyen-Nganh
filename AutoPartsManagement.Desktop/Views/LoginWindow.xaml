<Window x:Class="AutoPartsManagement.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3H AUTO - Đăng nhập" Width="940" Height="600"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        FontFamily="Segoe UI" FontSize="14" Background="White"
        Foreground="{StaticResource Ink}" Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="410" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- ===== Bên trái: thương hiệu ===== -->
        <Border Background="{StaticResource Red}">
            <Grid Margin="44">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="54" Height="54" CornerRadius="12" Background="White">
                            <TextBlock Text="&#xE804;" Style="{StaticResource IconText}" FontSize="28"
                                       Foreground="{StaticResource Red}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="32" Foreground="White">
                            <Run Text="3H" FontWeight="ExtraBold" /><Run Text=" AUTO" FontWeight="Light" />
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Margin="0,32,0,0" Text="Phụ tùng ô tô chính hãng" FontSize="23"
                               FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FFE3E3" LineHeight="21"
                               Text="Dùng chung tài khoản và dữ liệu với website: đặt hàng trên máy tính, theo dõi đơn và quản lý kho ở cùng một nơi." />

                    <StackPanel Margin="0,26,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" Foreground="White" Width="26" />
                            <TextBlock Text="Phụ tùng có mã OEM và xuất xứ rõ ràng" Foreground="White" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" Foreground="White" Width="26" />
                            <TextBlock Text="Tồn kho cập nhật ngay khi có đơn hàng" Foreground="White" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" Foreground="White" Width="26" />
                            <TextBlock Text="Nhắc lịch bảo dưỡng theo số km" Foreground="White" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock VerticalAlignment="Bottom" Foreground="#FFC9C9" FontSize="12"
                           Text="Đồ án chuyên ngành · Hệ thống quản lý phụ tùng ô tô" />
            </Grid>
        </Border>

        <!-- ===== Bên phải: form ===== -->
        <StackPanel Grid.Column="1" Margin="64,0" VerticalAlignment="Center">

            <!-- Đăng nhập -->
            <StackPanel x:Name="LoginPanel">
                <TextBlock Text="Đăng nhập" FontSize="27" FontWeight="Bold" />
                <TextBlock Text="Chào mừng bạn quay lại 3H AUTO!" Foreground="{StaticResource Muted}" Margin="0,4,0,10" />

                <TextBlock Text="Tên đăng nhập" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="LoginUser" Style="{StaticResource Input}" />

                <TextBlock Text="Mật khẩu" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="LoginPassword" Style="{StaticResource PasswordInput}" />

                <Button x:Name="LoginButton" Content="Đăng nhập" Style="{StaticResource PrimaryButton}"
                        Margin="0,24,0,0" IsDefault="True" IsEnabled="False" Click="Login_Click" />

                <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" Foreground="{StaticResource Muted}">
                    <Run Text="Chưa có tài khoản?" />
                    <Hyperlink Click="ShowRegister_Click">Đăng ký ngay</Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- Đăng ký -->
            <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">
                <TextBlock Text="Tạo tài khoản" FontSize="27" FontWeight="Bold" />
                <TextBlock Text="Đăng ký miễn phí, dùng được cả trên website." Foreground="{StaticResource Muted}" Margin="0,4,0,10" />

                <TextBlock Text="Tên đăng nhập" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="RegUser" Style="{StaticResource Input}" />

                <TextBlock Text="Mật khẩu" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="RegPassword" Style="{StaticResource PasswordInput}" />

                <TextBlock Text="Nhập lại mật khẩu" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="RegConfirm" Style="{StaticResource PasswordInput}" />

                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="Mật khẩu từ 6 ký tự, gồm chữ hoa, chữ thường, chữ số và ký tự đặc biệt (vd: Abc@123)." />

                <Button x:Name="RegisterButton" Content="Đăng ký" Style="{StaticResource PrimaryButton}"
                        Margin="0,20,0,0" IsEnabled="False" Click="Register_Click" />

                <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" Foreground="{StaticResource Muted}">
                    <Run Text="Đã có tài khoản?" />
                    <Hyperlink Click="ShowLogin_Click">Đăng nhập</Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- Thông báo lỗi / trạng thái -->
            <Border x:Name="ErrorBox" Margin="0,18,0,0" Padding="12,10" CornerRadius="6"
                    Background="{StaticResource RedSoft}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource RedDark}" TextWrapping="Wrap" />
                    <Button x:Name="RetryButton" Content="Thử kết nối lại" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed" Click="Retry_Click" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="StatusText" Margin="0,14,0,0" HorizontalAlignment="Center"
                       Foreground="{StaticResource Muted}" FontSize="13" />
        </StackPanel>
    </Grid>
</Window>
