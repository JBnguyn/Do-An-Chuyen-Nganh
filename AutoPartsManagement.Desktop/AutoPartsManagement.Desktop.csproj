<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AutoPartsManagement.Desktop</RootNamespace>
    <AssemblyTitle>3H AUTO - Ứng dụng quản lý phụ tùng</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoPartsManagement.Services\AutoPartsManagement.Services.csproj" />
    <ProjectReference Include="..\AutoPartsManagement.Data\AutoPartsManagement.Data.csproj" />
  </ItemGroup>

  <!-- Dùng chung (không sao chép) code tài khoản với project Web: role, tài khoản admin mẫu, thông báo lỗi tiếng Việt -->
  <ItemGroup>
    <Compile Include="..\AutoPartsManagement.Web\Identity\AppRoles.cs" Link="Shared\AppRoles.cs" />
    <Compile Include="..\AutoPartsManagement.Web\Identity\IdentitySeeder.cs" Link="Shared\IdentitySeeder.cs" />
    <Compile Include="..\AutoPartsManagement.Web\Identity\VietnameseIdentityErrorDescriber.cs" Link="Shared\VietnameseIdentityErrorDescriber.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
