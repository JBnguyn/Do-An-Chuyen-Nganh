@model ProductIndexViewModel
@{
    ViewData["Title"] = "Danh mục phụ tùng";
    var f = Model.Filter;
    var hasFilter = !string.IsNullOrWhiteSpace(f.Search) || f.CategoryId.HasValue || f.BrandId.HasValue
                    || !string.IsNullOrEmpty(f.StockStatus) || f.IsActive.HasValue || !string.IsNullOrEmpty(f.SortBy);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="bi bi-box-seam"></i> Danh mục phụ tùng</h2>
    @if (User.IsInRole(AppRoles.Admin))
    {
        <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-lg"></i> Thêm phụ tùng</a>
    }
</div>

@* ---- Thống kê nhanh ---- *@
<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="card stat-card border-primary">
            <div class="card-body">
                <div class="text-muted small">Tổng phụ tùng</div>
                <div class="fs-4 fw-bold">@Format.Number(Model.Stats.TotalProducts)</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card border-success">
            <div class="card-body">
                <div class="text-muted small">Đang kinh doanh</div>
                <div class="fs-4 fw-bold text-success">@Format.Number(Model.Stats.ActiveProducts)</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <a class="text-decoration-none" asp-action="Index" asp-route-stockStatus="low" asp-route-isActive="true">
            <div class="card stat-card border-warning">
                <div class="card-body">
                    <div class="text-muted small">Sắp hết (≤ @InventoryRules.LowStockThreshold)</div>
                    <div class="fs-4 fw-bold text-warning">@Format.Number(Model.Stats.LowStock)</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a class="text-decoration-none" asp-action="Index" asp-route-stockStatus="out" asp-route-isActive="true">
            <div class="card stat-card border-danger">
                <div class="card-body">
                    <div class="text-muted small">Hết hàng</div>
                    <div class="fs-4 fw-bold text-danger">@Format.Number(Model.Stats.OutOfStock)</div>
                </div>
            </div>
        </a>
    </div>
</div>

@* ---- Bộ lọc ---- *@
<form method="get" asp-action="Index" class="card card-body shadow-sm mb-3">
    <div class="row g-2">
        <div class="col-md-4">
            <label class="form-label small mb-1">Tìm kiếm</label>
            <input type="text" name="search" value="@f.Search" class="form-control" placeholder="Tên hoặc mã phụ tùng..." />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1">Danh mục</label>
            <select name="categoryId" asp-items="Model.Categories" class="form-select">
                <option value="">-- Tất cả --</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1">Hãng</label>
            <select name="brandId" asp-items="Model.Brands" class="form-select">
                <option value="">-- Tất cả --</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1">Tồn kho</label>
            <select name="stockStatus" class="form-select">
                <option value="">-- Tất cả --</option>
                <option value="in" selected="@(f.StockStatus == "in")">Còn hàng</option>
                <option value="low" selected="@(f.StockStatus == "low")">Sắp hết</option>
                <option value="out" selected="@(f.StockStatus == "out")">Hết hàng</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1">Trạng thái</label>
            <select name="isActive" class="form-select">
                <option value="">-- Tất cả --</option>
                <option value="true" selected="@(f.IsActive == true)">Đang kinh doanh</option>
                <option value="false" selected="@(f.IsActive == false)">Ngừng kinh doanh</option>
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small mb-1">Sắp xếp</label>
            <select name="sortBy" class="form-select">
                <option value="">Tên A → Z</option>
                <option value="name_desc" selected="@(f.SortBy == "name_desc")">Tên Z → A</option>
                <option value="price" selected="@(f.SortBy == "price")">Giá tăng dần</option>
                <option value="price_desc" selected="@(f.SortBy == "price_desc")">Giá giảm dần</option>
                <option value="stock" selected="@(f.SortBy == "stock")">Tồn kho tăng dần</option>
                <option value="stock_desc" selected="@(f.SortBy == "stock_desc")">Tồn kho giảm dần</option>
                <option value="newest" selected="@(f.SortBy == "newest")">Mới thêm gần đây</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1">Số dòng / trang</label>
            <select name="pageSize" class="form-select">
                @foreach (var size in new[] { 10, 20, 50 })
                {
                    <option value="@size" selected="@(Model.Result.PageSize == size)">@size</option>
                }
            </select>
        </div>
        <div class="col-md-auto d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-funnel"></i> Lọc</button>
            @if (hasFilter)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
            }
        </div>
    </div>
</form>

@* ---- Danh sách ---- *@
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:70px">Ảnh</th>
                    <th>Mã phụ tùng</th>
                    <th>Tên phụ tùng</th>
                    <th>Danh mục</th>
                    <th>Hãng</th>
                    <th class="text-end">Giá bán</th>
                    <th class="text-center">Tồn kho</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-end" style="width:150px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Result.Items.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">Không tìm thấy phụ tùng nào.</td></tr>
                }
                @foreach (var p in Model.Result.Items)
                {
                    <tr class="@(p.IsActive ? "" : "table-secondary text-muted")">
                        <td>
                            @if (!string.IsNullOrEmpty(p.ImageUrl))
                            {
                                <img src="@p.ImageUrl" alt="@p.Name" class="thumb-sm" />
                            }
                            else
                            {
                                <div class="thumb-sm thumb-empty"><i class="bi bi-image"></i></div>
                            }
                        </td>
                        <td><code>@p.PartNumber</code></td>
                        <td>
                            <a asp-action="Details" asp-route-id="@p.Id" class="fw-semibold text-decoration-none">@p.Name</a>
                        </td>
                        <td>@p.Category?.Name</td>
                        <td>@p.Brand?.Name</td>
                        <td class="text-end text-nowrap">@Format.Money(p.Price)</td>
                        <td class="text-center"><partial name="_StockBadge" model="p.Stock" /></td>
                        <td class="text-center">
                            @if (p.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success-emphasis">Đang bán</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Ngừng</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary" title="Chi tiết"><i class="bi bi-eye"></i></a>
                            @if (User.IsInRole(AppRoles.Admin))
                            {
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary" title="Sửa"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="Model.Result" />
