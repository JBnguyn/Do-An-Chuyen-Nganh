@model PagedResult<Order>
@using AutoPartsManagement.Data.Models.Enums
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    var current = ViewData["Status"] as OrderStatus?;
    var search = ViewData["Search"] as string;
    var counts = ViewData["Counts"] as Dictionary<OrderStatus, int> ?? new();
    var total = counts.Values.Sum();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="bi bi-clipboard-check"></i> Quản lý đơn hàng</h2>
</div>

@* ---- Lọc theo trạng thái ---- *@
<ul class="nav nav-pills mb-3 gap-1 flex-wrap">
    <li class="nav-item">
        <a class="nav-link @(current == null ? "active" : "")" asp-action="Index" asp-route-search="@search">
            Tất cả <span class="badge bg-light text-dark ms-1">@total</span>
        </a>
    </li>
    @foreach (var s in Enum.GetValues<OrderStatus>())
    {
        <li class="nav-item">
            <a class="nav-link @(current == s ? "active" : "")" asp-action="Index" asp-route-status="@s" asp-route-search="@search">
                @OrderUi.Label(s) <span class="badge @OrderUi.Badge(s) ms-1">@(counts.GetValueOrDefault(s))</span>
            </a>
        </li>
    }
</ul>

<form method="get" asp-action="Index" class="card card-body shadow-sm mb-3">
    <input type="hidden" name="status" value="@current" />
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" name="search" value="@search" class="form-control" placeholder="Tìm theo mã đơn (#12), tên khách hoặc số điện thoại..." />
        <button type="submit" class="btn btn-primary">Tìm</button>
        @if (!string.IsNullOrWhiteSpace(search))
        {
            <a asp-action="Index" asp-route-status="@current" class="btn btn-outline-secondary">Xóa</a>
        }
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã đơn</th>
                    <th>Ngày đặt</th>
                    <th>Khách hàng</th>
                    <th>Điện thoại</th>
                    <th class="text-center">Số SP</th>
                    <th class="text-end">Tổng tiền</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">Chưa có đơn hàng nào.</td></tr>
                }
                @foreach (var o in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">#@o.Id</td>
                        <td class="text-nowrap">@Format.DateAndTime(o.OrderDate)</td>
                        <td>@o.Customer?.Name</td>
                        <td>@o.Customer?.Phone</td>
                        <td class="text-center">@o.OrderDetails.Sum(d => d.Quantity)</td>
                        <td class="text-end text-nowrap fw-semibold">@Format.Money(o.TotalAmount)</td>
                        <td class="text-center"><span class="badge @OrderUi.Badge(o.Status)">@OrderUi.Label(o.Status)</span></td>
                        <td class="text-end">
                            <a asp-action="Detail" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i> Xem</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="Model" />
