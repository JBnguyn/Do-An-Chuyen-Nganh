@model List<Order>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<div class="container">
    <nav class="shop-breadcrumb" aria-label="breadcrumb">
        <a asp-controller="Shop" asp-action="Index">Trang chủ</a> <i class="bi bi-chevron-right"></i> <span>Đơn hàng của tôi</span>
    </nav>

    <section class="shop-section">
        <h1 class="shop-section-title mb-3">Đơn hàng của tôi</h1>

        @if (Model.Count == 0)
        {
            <div class="shop-empty">
                <i class="bi bi-receipt"></i>
                Bạn chưa có đơn hàng nào.
                <div class="mt-3"><a class="btn btn-shop" asp-controller="Shop" asp-action="Search">Mua sắm ngay</a></div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var o in Model)
                {
                    var first = o.OrderDetails.FirstOrDefault();
                    var more = o.OrderDetails.Count - 1;
                    <a class="order-card" asp-action="Detail" asp-route-id="@o.Id">
                        <div class="order-card-head">
                            <span><b>Đơn #@o.Id</b> <small class="text-muted ms-2">@Format.DateAndTime(o.OrderDate)</small></span>
                            <span class="badge @OrderUi.Badge(o.Status)"><i class="bi @OrderUi.Icon(o.Status)"></i> @OrderUi.Label(o.Status)</span>
                        </div>
                        <div class="order-card-body">
                            <div class="order-thumb">
                                @if (!string.IsNullOrEmpty(first?.Product?.ImageUrl))
                                {
                                    <img src="@first.Product.ImageUrl" alt="" />
                                }
                                else
                                {
                                    <i class="bi bi-box-seam"></i>
                                }
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold">@first?.Product?.Name</div>
                                <small class="text-muted">x@(first?.Quantity) @(more > 0 ? $"và {more} sản phẩm khác" : "")</small>
                            </div>
                            <div class="text-end">
                                <small class="text-muted d-block">Tổng tiền</small>
                                <b class="text-danger">@Format.Money(o.TotalAmount)</b>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    </section>
</div>
