@model Order
@using AutoPartsManagement.Data.Models.Enums
@{
    ViewData["Title"] = $"Đơn hàng #{Model.Id}";
}

<div class="container">
    <nav class="shop-breadcrumb" aria-label="breadcrumb">
        <a asp-controller="Shop" asp-action="Index">Trang chủ</a> <i class="bi bi-chevron-right"></i>
        <a asp-action="Index">Đơn hàng của tôi</a> <i class="bi bi-chevron-right"></i>
        <span>Đơn #@Model.Id</span>
    </nav>

    <section class="shop-section">
        <div class="shop-section-head">
            <h1 class="shop-section-title">Đơn hàng #@Model.Id</h1>
            <span class="badge fs-6 @OrderUi.Badge(Model.Status)"><i class="bi @OrderUi.Icon(Model.Status)"></i> @OrderUi.Label(Model.Status)</span>
        </div>
        <p class="text-muted">Đặt lúc @Format.DateAndTime(Model.OrderDate)</p>
        <partial name="_OrderProgress" model="Model.Status" />
    </section>

    <div class="row g-4">
        <div class="col-lg-8">
            <section class="shop-section">
                <h2 class="shop-section-title mb-3">Sản phẩm</h2>
                <partial name="_OrderItems" model="Model" />
            </section>
        </div>
        <div class="col-lg-4">
            <section class="shop-section">
                <h2 class="shop-section-title mb-3">Giao đến</h2>
                <p class="mb-1 fw-semibold">@Model.Customer?.Name</p>
                <p class="mb-1"><i class="bi bi-telephone text-danger"></i> @Model.Customer?.Phone</p>
                <p class="mb-1"><i class="bi bi-geo-alt text-danger"></i> @Model.Customer?.Address</p>
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <p class="mb-0 mt-2 small text-muted" style="white-space:pre-line"><b>Ghi chú:</b> @Model.Notes</p>
                }
                <hr />
                <p class="small text-muted mb-0"><i class="bi bi-cash-coin"></i> Thanh toán khi nhận hàng (COD)</p>
            </section>

            @if (Model.Status == OrderStatus.Pending)
            {
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn #@Model.Id?');">
                    <button type="submit" class="btn btn-outline-danger w-100"><i class="bi bi-x-circle"></i> Hủy đơn hàng</button>
                </form>
            }
        </div>
    </div>
</div>
