@model Order
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

@* Đánh dấu để shop.js xóa giỏ hàng sau khi đặt thành công *@
<span data-clear-cart hidden></span>

<div class="container">
    <section class="shop-section text-center py-5">
        <div class="checkout-success-icon"><i class="bi bi-check-lg"></i></div>
        <h1 class="h3 fw-bold mt-3">Đặt hàng thành công!</h1>
        <p class="text-muted mb-1">Mã đơn hàng: <b class="text-dark">#@Model.Id</b> – Tổng tiền: <b class="text-danger">@Format.Money(Model.TotalAmount)</b></p>
        <p class="text-muted">Cửa hàng sẽ gọi số <b>@Model.Customer?.Phone</b> để xác nhận đơn trong giờ làm việc.</p>
        <div class="d-flex flex-wrap justify-content-center gap-2 mt-3">
            <a class="btn btn-shop" asp-controller="MyOrders" asp-action="Detail" asp-route-id="@Model.Id"><i class="bi bi-receipt"></i> Xem đơn hàng</a>
            <a class="btn btn-outline-secondary" asp-controller="Shop" asp-action="Index">Tiếp tục mua sắm</a>
        </div>
    </section>

    <section class="shop-section">
        <h2 class="shop-section-title mb-3">Chi tiết đơn #@Model.Id</h2>
        <partial name="_OrderItems" model="Model" />
    </section>
</div>
