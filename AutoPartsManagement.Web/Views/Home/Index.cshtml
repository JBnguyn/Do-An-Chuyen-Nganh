@{
    ViewData["Title"] = "Trang chủ";
}

<div class="p-4 p-md-5 mb-4 bg-dark text-white rounded-3">
    <h1 class="fw-bold">3H AUTO</h1>
    <p class="lead mb-0">Hệ thống quản lý kho phụ tùng ô tô</p>
</div>

<div class="row g-3">
    <div class="col-sm-6 col-lg-3">
        <a asp-controller="Products" asp-action="Index" class="card home-card text-decoration-none h-100">
            <div class="card-body">
                <i class="bi bi-box-seam fs-2 text-primary"></i>
                <h5 class="mt-2 mb-1">Phụ tùng</h5>
                <p class="text-muted small mb-0">Danh sách, tìm kiếm, tồn kho</p>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a asp-controller="Categories" asp-action="Index" class="card home-card text-decoration-none h-100">
            <div class="card-body">
                <i class="bi bi-tags fs-2 text-success"></i>
                <h5 class="mt-2 mb-1">Danh mục</h5>
                <p class="text-muted small mb-0">Phân loại phụ tùng</p>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a asp-controller="Brands" asp-action="Index" class="card home-card text-decoration-none h-100">
            <div class="card-body">
                <i class="bi bi-award fs-2 text-warning"></i>
                <h5 class="mt-2 mb-1">Hãng sản xuất</h5>
                <p class="text-muted small mb-0">Bosch, Denso, KYB, ...</p>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a asp-controller="Suppliers" asp-action="Index" class="card home-card text-decoration-none h-100">
            <div class="card-body">
                <i class="bi bi-truck fs-2 text-danger"></i>
                <h5 class="mt-2 mb-1">Nhà cung cấp</h5>
                <p class="text-muted small mb-0">Đối tác nhập hàng</p>
            </div>
        </a>
    </div>
</div>
