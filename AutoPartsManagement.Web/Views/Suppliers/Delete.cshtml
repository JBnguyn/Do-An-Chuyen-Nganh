@model Supplier
@{
    ViewData["Title"] = "Xóa nhà cung cấp";
    var importCount = (int)(ViewData["ImportCount"] ?? 0);
}

<h2 class="mb-3 text-danger">Xóa nhà cung cấp</h2>

<div class="card shadow-sm" style="max-width:640px">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Tên</dt>
            <dd class="col-sm-8">@Model.Name</dd>
            <dt class="col-sm-4">Điện thoại</dt>
            <dd class="col-sm-8">@Model.Phone</dd>
            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@(Model.Email ?? "—")</dd>
            <dt class="col-sm-4">Địa chỉ</dt>
            <dd class="col-sm-8">@(Model.Address ?? "—")</dd>
            <dt class="col-sm-4">Số phiếu nhập</dt>
            <dd class="col-sm-8">@importCount</dd>
        </dl>
    </div>
    <div class="card-footer">
        @if (importCount > 0)
        {
            <div class="alert alert-warning mb-3">
                Nhà cung cấp đã có <strong>@importCount</strong> phiếu nhập nên không thể xóa.
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
        }
        else
        {
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <p class="mb-2">Bạn có chắc muốn xóa nhà cung cấp này?</p>
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Xóa</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </form>
        }
    </div>
</div>
