@model List<Order>
@if (Model.Count > 0)
{
    <div class="chat-orders">
        <span class="chat-orders-title"><i class="bi bi-receipt"></i> Đơn gần đây</span>
        @foreach (var o in Model)
        {
            <a class="chat-order" asp-area="" asp-controller="MyOrders" asp-action="Detail" asp-route-id="@o.Id" title="Đặt lúc @Format.DateAndTime(o.OrderDate)">
                <b>#@o.Id</b> <span class="badge @OrderUi.Badge(o.Status)">@OrderUi.Label(o.Status)</span>
            </a>
        }
        <a class="chat-orders-all" asp-area="" asp-controller="MyOrders" asp-action="Index">Tất cả</a>
    </div>
}
