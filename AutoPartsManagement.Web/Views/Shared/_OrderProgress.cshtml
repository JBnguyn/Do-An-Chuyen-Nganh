@model AutoPartsManagement.Data.Models.Enums.OrderStatus
@using AutoPartsManagement.Data.Models.Enums
@* Thanh tiến trình trạng thái đơn hàng *@
@if (Model == OrderStatus.Cancelled)
{
    <div class="alert alert-secondary mb-0"><i class="bi bi-x-circle"></i> Đơn hàng đã bị hủy.</div>
}
else
{
    var current = Array.IndexOf(OrderUi.Steps, Model);
    <div class="order-steps">
        @for (var i = 0; i < OrderUi.Steps.Length; i++)
        {
            var s = OrderUi.Steps[i];
            <div class="order-step @(i < current ? "done" : i == current ? "current" : "")">
                <span class="order-step-dot"><i class="bi @OrderUi.Icon(s)"></i></span>
                <small>@OrderUi.Label(s)</small>
            </div>
        }
    </div>
}
