@model ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

<h2 class="text-danger"><i class="bi bi-exclamation-triangle"></i> Đã xảy ra lỗi</h2>
<p>Hệ thống gặp sự cố khi xử lý yêu cầu của bạn. Vui lòng thử lại sau ít phút.</p>

@if (Model.ShowRequestId)
{
    <p class="text-muted">
        Mã yêu cầu: <code>@Model.RequestId</code>
    </p>
}

<a asp-area="" asp-controller="Shop" asp-action="Index" class="btn btn-primary"><i class="bi bi-house"></i> Về trang chủ</a>
