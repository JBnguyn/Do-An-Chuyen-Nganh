@model IPagedResult
@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    // Giữ nguyên các điều kiện tìm kiếm / lọc trên URL, chỉ thay số trang
    string PageUrl(int page)
    {
        var values = new Microsoft.AspNetCore.Routing.RouteValueDictionary();
        foreach (var q in Context.Request.Query)
        {
            if (!string.Equals(q.Key, "page", StringComparison.OrdinalIgnoreCase))
                values[q.Key] = q.Value.ToString();
        }
        values["page"] = page;
        return Url.Action(action, values) ?? "#";
    }

    var from = Model.TotalCount == 0 ? 0 : (Model.PageIndex - 1) * Model.PageSize + 1;
    var to = Math.Min(Model.PageIndex * Model.PageSize, Model.TotalCount);
    var start = Math.Max(1, Model.PageIndex - 2);
    var end = Math.Min(Model.TotalPages, Model.PageIndex + 2);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
    <small class="text-muted">Hiển thị @from–@to / @Model.TotalCount bản ghi</small>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Phân trang">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@PageUrl(Model.PageIndex - 1)" aria-label="Trang trước">&laquo;</a>
                </li>
                @if (start > 1)
                {
                    <li class="page-item"><a class="page-link" href="@PageUrl(1)">1</a></li>
                    @if (start > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                }
                @for (var i = start; i <= end; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" href="@PageUrl(i)">@i</a>
                    </li>
                }
                @if (end < Model.TotalPages)
                {
                    @if (end < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                    <li class="page-item"><a class="page-link" href="@PageUrl(Model.TotalPages)">@Model.TotalPages</a></li>
                }
                <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@PageUrl(Model.PageIndex + 1)" aria-label="Trang sau">&raquo;</a>
                </li>
            </ul>
        </nav>
    }
</div>
