@model PagedResult<BrandListItem>
@{
    ViewData["Title"] = "Hãng sản xuất";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="bi bi-award"></i> Hãng sản xuất</h2>
    @if (User.IsInRole(AppRoles.Admin))
    {
        <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-lg"></i> Thêm hãng</a>
    }
</div>

<partial name="_SearchBox" model="@("Tìm theo tên hãng hoặc quốc gia...")" />

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:70px">#</th>
                    <th style="width:80px">Logo</th>
                    <th>Tên hãng</th>
                    <th>Quốc gia</th>
                    <th class="text-center">Số phụ tùng</th>
                    <th class="text-end" style="width:140px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Không có hãng nào.</td></tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.LogoUrl))
                            {
                                <img src="@item.LogoUrl" alt="@item.Name" class="thumb-sm" />
                            }
                        </td>
                        <td class="fw-semibold">@item.Name</td>
                        <td>@item.Country</td>
                        <td class="text-center">
                            <a asp-controller="Products" asp-action="Index" asp-route-brandId="@item.Id" class="badge bg-secondary text-decoration-none">
                                @item.ProductCount
                            </a>
                        </td>
                        <td class="text-end">
                            @if (User.IsInRole(AppRoles.Admin))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Sửa"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="Model" />
