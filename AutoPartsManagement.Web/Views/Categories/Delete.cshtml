@model Category
@{
    ViewData["Title"] = "Xóa danh mục";
    var productCount = (int)(ViewData["ProductCount"] ?? 0);
}

<h2 class="mb-3 text-danger">Xóa danh mục</h2>

<div class="card shadow-sm" style="max-width:640px">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Tên danh mục</dt>
            <dd class="col-sm-8">@Model.Name</dd>
            <dt class="col-sm-4">Mô tả</dt>
            <dd class="col-sm-8">@(Model.Description ?? "—")</dd>
            <dt class="col-sm-4">Số phụ tùng</dt>
            <dd class="col-sm-8">@productCount</dd>
        </dl>
    </div>
    <div class="card-footer">
        @if (productCount > 0)
        {
            <div class="alert alert-warning mb-3">
                Danh mục đang có <strong>@productCount</strong> phụ tùng nên không thể xóa.
                Hãy chuyển các phụ tùng sang danh mục khác trước.
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
        }
        else
        {
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <p class="mb-2">Bạn có chắc muốn xóa danh mục này?</p>
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Xóa</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </form>
        }
    </div>
</div>
