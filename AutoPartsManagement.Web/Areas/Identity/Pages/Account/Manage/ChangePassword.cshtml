@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    ViewData["ActivePage"] = "ChangePassword";
}

<h1 class="shop-section-title mb-1">Đổi mật khẩu</h1>
<p class="text-muted mb-4">Nên dùng mật khẩu mạnh và không trùng với trang web khác.</p>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success py-2">@Model.StatusMessage</div>
}

<form id="change-password-form" method="post" style="max-width: 480px">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Input.OldPassword" class="form-label fw-semibold">Mật khẩu hiện tại</label>
        <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.NewPassword" class="form-label fw-semibold">Mật khẩu mới</label>
        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
        <div class="form-text">Tối thiểu 6 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt (vd: Abc@123).</div>
    </div>
    <div class="mb-4">
        <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold">Nhập lại mật khẩu mới</label>
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-shop px-4"><i class="bi bi-key"></i> Đổi mật khẩu</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
